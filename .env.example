# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# Allowed Hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,quick-connect-phi.vercel.app

# Database - Choose ONE:
# Option 1: PostgreSQL (Recommended for Vercel)
# DATABASE_URL=postgresql://username:password@host:5432/dbname

# Option 2: MySQL (if you have external MySQL hosting)
# DATABASE_URL=mysql://username:password@host:3306/dbname

# Option 3: SQLite (Development only - leave as default in code)
# DATABASE_URL=sqlite:///db.sqlite3

# Email Configuration (Optional - for sending emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Django Admin Settings Module (Usually no need to change)
DJANGO_SETTINGS_MODULE=quick_connect.settings
