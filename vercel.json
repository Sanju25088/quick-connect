{
  "version": 2,
  "buildCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt && python manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "quick_connect/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "^/(.*)$",
      "dest": "quick_connect/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "quick_connect.settings"
  }
}
